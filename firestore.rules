rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para usuarios individuales (si existían)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Reglas para la colección de usuarios de DidactIA
    match /usuarios/{userId} {
      allow create: if request.auth != null;
      allow read, delete: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == "zlagustin10@gmail.com");
    }
  }
}