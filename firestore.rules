rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para usuarios individuales (si existían)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Colección de docentes registrados en DidactIA
    match /usuarios/{userId} {
      // Cualquier docente autenticado puede crear su propio registro
      allow create: if request.auth != null;
      // Un docente puede leer/borrar su propio registro
      // El panel admin puede leer y borrar todos (autenticación controlada por contraseña local)
      allow read, delete: if true;
    }
  }
}